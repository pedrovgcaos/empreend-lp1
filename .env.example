# Senha de acesso ao painel /admin (obrigatória)
ADMIN_PASSWORD=troque-esta-senha

# Chave para assinar o cookie de sessão do admin (opcional, recomendado).
# Gere uma string aleatória longa. Se vazia, usa a ADMIN_PASSWORD.
ADMIN_SECRET=

# Token do Vercel Blob. Na Vercel é criado automaticamente ao conectar
# um Blob Store ao projeto (Storage > Blob). Sem ele, o projeto salva em
# ./.data (só funciona localmente).
BLOB_READ_WRITE_TOKEN=

# Webhook que recebe os leads do formulário (Make, Zapier, n8n, RD Station, CRM...).
# Se preenchido, tem prioridade sobre o webhook configurado no painel.
LEAD_WEBHOOK_URL=
